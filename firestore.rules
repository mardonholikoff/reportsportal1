rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Clients collection
    match /clients/{clientId} {
      allow read: if true;
      allow write: if isValidId(clientId);
    }

    // Daily plans collection (Agent activities, actions, plans)
    match /dailyPlans/{planId} {
      allow read: if true;
      allow write: if isValidId(planId);
    }

    // Warehouse products collection
    match /warehouseProducts/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // System activity & audit logs collection
    match /systemLogs/{logId} {
      allow read: if true;
      allow write: if isValidId(logId);
    }

    // Monthly plans collection (1 oylik qarz undirish rejalari)
    match /monthlyPlans/{planId} {
      allow read: if true;
      allow write: if isValidId(planId);
    }
  }
}
